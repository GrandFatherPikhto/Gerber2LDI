# Gerber2LDI messages (ru).
msgid ""
msgstr ""
"Project-Id-Version: gerber2ldi 0.1.0.dev0\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Laser direct imaging of photoresist from Gerber files."
msgstr "Засветка фоторезиста лазером по файлам Gerber."

msgid "show what is in a Gerber layer"
msgstr "показать, что лежит в слое гербера"

msgid "turn a Gerber layer into rows and a preview TIFF"
msgstr "превратить слой гербера в строки и превью TIFF"

msgid "Gerber file"
msgstr "Файл гербера"

msgid "output TIFF"
msgstr "выходной файл TIFF"

msgid "preview pixel size across, mm"
msgstr "размер пикселя превью по X, мм"

msgid "machine row step, mm"
msgstr "шаг строк станка, мм"

msgid "File: {path}"
msgstr "Файл: {path}"

msgid "Units in file: {unit}"
msgstr "Единицы в файле: {unit}"

msgid "Size: {width:.3f} x {height:.3f} mm"
msgstr "Размер: {width:.3f} x {height:.3f} мм"

msgid "Apertures: {count}"
msgstr "Апертур: {count}"

msgid "Shapes: {count}"
msgstr "Фигур: {count}"

msgid "Clear polarity present: {yes_no}"
msgstr "Светлая полярность есть: {yes_no}"

msgid "yes"
msgstr "да"

msgid "no"
msgstr "нет"

msgid "Wrote {path}: {rows} rows, {filled} with copper"
msgstr "Записано {path}: строк {rows}, с медью {filled}"

msgid "File not found: {path}"
msgstr "Файл не найден: {path}"

msgid "Cannot read Gerber file {path}: {error}"
msgstr "Не удалось прочитать гербер {path}: {error}"

msgid "Cannot read drill file {path}: {error}"
msgstr "Не удалось прочитать сверловку {path}: {error}"

msgid "expected a number, got {value}"
msgstr "ожидалось число, пришло {value}"

msgid "expected a positive size in mm, got {value}"
msgstr "ожидался положительный размер в мм, пришло {value}"

msgid "Cannot draw {kind} of object #{index}: {error}"
msgstr "Не удалось нарисовать {kind} объекта #{index}: {error}"

msgid "Object #{index} produced a {kind} without an outline"
msgstr "Объект #{index} дал {kind} без контура"

msgid "Drill hit #{index} ({kind}) has no position or diameter"
msgstr "Отверстие #{index} ({kind}) без координат или диаметра"

msgid "Profile file not found: {path}"
msgstr "Файл профиля не найден: {path}"

msgid "Cannot read profile {path}: {error}"
msgstr "Не удалось прочитать профиль {path}: {error}"

msgid "Cannot read calibration {path}: {error}"
msgstr "Не удалось прочитать калибровку {path}: {error}"

msgid "Profile {path}: [{section}] section is required"
msgstr "Профиль {path}: нужна секция [{section}]"

msgid "Profile {path}: [calibration] section is required"
msgstr "Профиль {path}: нужна секция [calibration]"

msgid "Profile {path}: {field} is required"
msgstr "Профиль {path}: нужно поле {field}"

msgid "Profile {path}: {field} must be {expectation}, got {value}"
msgstr "Профиль {path}: поле {field} должно быть {expectation}, пришло {value}"

msgid "Machine is not calibrated: {path} not found; assuming scale 1 and skew 0"
msgstr "Станок не откалиброван: {path} не найден; приняты масштаб 1 и перекос 0"

msgid "Spot radius not measured in {path}; compensation needs a measurement (use --no-spot-compensation to work without it)"
msgstr "Радиус пятна не измерен в {path}; компенсация требует замера (работать без неё — --no-spot-compensation)"

msgid "Spot radius not measured in {path}: compensation stays unavailable until it is measured"
msgstr "Радиус пятна не измерен в {path}: компенсация недоступна, пока нет замера"

msgid "Unknown {field} {value} (one of {allowed})"
msgstr "Неизвестное {field}: {value} (одно из {allowed})"

msgid "side"
msgstr "сторона"

msgid "process"
msgstr "процесс"

msgid "Requested power {requested} must be a fraction above zero"
msgstr "Запрошенная мощность {requested} должна быть долей больше нуля"

msgid "Requested power {requested} is above the ceiling {ceiling} from {path}"
msgstr "Запрошенная мощность {requested} выше потолка {ceiling} из {path}"

msgid "The job is empty: nothing to expose after the transforms"
msgstr "Задание пустое: после преобразований засвечивать нечего"

msgid "Spot compensation is off: every line is exposed wider than drawn by the spot radius"
msgstr "Компенсация пятна выключена: каждая линия светится шире нарисованной на радиус пятна"

msgid "The pass runs {start} … {end} mm across, the table spans 0 … {table} mm"
msgstr "Проход идёт {start} … {end} мм по X, стол занимает 0 … {table} мм"

msgid "The pass runs {start} … {end} mm along, the table spans 0 … {table} mm"
msgstr "Проход идёт {start} … {end} мм по Y, стол занимает 0 … {table} мм"

msgid "Table origin {origin} is not supported yet: only {supported}"
msgstr "Начало координат стола {origin} пока не поддерживается: только {supported}"

msgid "expected two millimetres separated by a comma, got {value}"
msgstr "ожидались два миллиметра через запятую, пришло {value}"

msgid "where to put the run-up start, mm as X,Y"
msgstr "куда поставить начало разгона, мм как X,Y"

msgid "PWM period {period} mm is wider than the spot radius {radius} mm: dashes, not a line"
msgstr "Период ШИМ {period} мм шире радиуса пятна {radius} мм: будут штрихи, а не линия"

msgid "expected a fraction in (0, 1], got {value}"
msgstr "ожидалась доля в (0, 1], пришло {value}"

msgid "machine profile (TOML)"
msgstr "профиль станка (TOML)"

msgid "side of the board"
msgstr "сторона платы"

msgid "process: what the resist does"
msgstr "процесс: что делает резист"

msgid "laser power as a fraction of the module"
msgstr "мощность лазера долей от модуля"

msgid "work without a measured spot radius"
msgstr "работать без измеренного радиуса пятна"

msgid "make a machine job"
msgstr "собрать задание для станка"

msgid "output G-code"
msgstr "выходной G-code"

msgid "draw what the machine will do"
msgstr "нарисовать, что сделает станок"

msgid "input Gerber or G-code"
msgstr "входной гербер или G-code"

msgid "output PNG"
msgstr "выходной PNG"

msgid "Wrote {path}: {rows} rows, {segments} segments, S{s}"
msgstr "Записано {path}: строк {rows}, отрезков {segments}, S{s}"

msgid "Wrote {path}"
msgstr "Записано {path}"

msgid "Preview without a profile: no calibration and no compensation applied"
msgstr "Превью без профиля: калибровка и компенсация не применены"

msgid "The job carries {given} row powers for {rows} rows"
msgstr "В задании {given} мощностей строк на {rows} строк"

msgid "Power band {y0} … {y1} mm has a non-finite {field}"
msgstr "Полоса мощности {y0} … {y1} мм: поле {field} не конечное число"

msgid "Power band {y0} … {y1} mm is empty: the upper edge must be above the lower one"
msgstr "Полоса мощности {y0} … {y1} мм пуста: верхняя граница должна быть выше нижней"

msgid "Power band {y0} … {y1} mm asks for {power}: the fraction must be above zero"
msgstr "Полоса мощности {y0} … {y1} мм просит {power}: доля должна быть больше нуля"

msgid "Power bands {a0} … {a1} and {b0} … {b1} mm overlap"
msgstr "Полосы мощности {a0} … {a1} и {b0} … {b1} мм пересекаются"

msgid "Power is required: one value, or bands for a dose strip"
msgstr "Нужна мощность: одно значение или полосы для полоски дозы"

msgid "Either one power or power bands, not both"
msgstr "Либо одна мощность, либо полосы мощности — не вместе"

msgid "Power bands cannot be combined with spot compensation: it adds and removes rows, so a band would no longer own its rows (a dose strip runs with --no-spot-compensation)"
msgstr "Полосы мощности нельзя совмещать с компенсацией пятна: она добавляет и убирает строки, и полоса перестанет владеть своими строками (полоска дозы идёт с --no-spot-compensation)"

msgid "Row at {y} mm exposes copper outside every power band: the pattern and its bands disagree"
msgstr "Строка на {y} мм светит медь вне всех полос мощности: шаблон и его полосы расходятся"

msgid "Power band {y0} … {y1} mm covers no machine row at a {step} mm row step"
msgstr "Полоса мощности {y0} … {y1} мм не накрывает ни одной строки станка при шаге строк {step} мм"

msgid "A note for the G-code header is not ASCII: {text}"
msgstr "Заметка для шапки G-code не в ASCII: {text}"

msgid "bar widths: {error}"
msgstr "ширины штрихов: {error}"

msgid "at least one bar width is required"
msgstr "нужна хотя бы одна ширина штриха"

msgid "power levels: {error}"
msgstr "уровни мощности: {error}"

msgid "at least one power level is required"
msgstr "нужен хотя бы один уровень мощности"

msgid "expected a whole number, got {value}"
msgstr "ожидалось целое число, пришло {value}"

msgid "a dose series needs at least two levels, got {value}"
msgstr "ряду дозы нужно не меньше двух уровней, пришло {value}"

msgid "Use either --powers or --from/--to/--count, not both"
msgstr "Либо --powers, либо --from/--to/--count — не вместе"

msgid "A dose strip needs its levels: --powers 0.02,0.03,... or --from, --to and --count"
msgstr "Полоске дозы нужны уровни: --powers 0.02,0.03,... или --from, --to и --count"

msgid "--from, --to and --count go together: one of them is missing"
msgstr "--from, --to и --count идут вместе: одного из них не хватает"

msgid "Bars: widths in fixed order {widths} mm, gap = width, five lines per group"
msgstr "Штрихи: ширины в фиксированном порядке {widths} мм, промежуток равен ширине, пять линий в группе"

msgid "Layout: horizontal groups at the bottom left (along X: Y resolution), vertical groups to their right (along Y: X resolution)"
msgstr "Раскладка: горизонтальные группы слева внизу (вдоль X: разрешение по Y), вертикальные справа от них (вдоль Y: разрешение по X)"

msgid "Dose strip: {count} tiles bottom to top, each with its own power"
msgstr "Полоска дозы: {count} прямоугольников снизу вверх, у каждого своя мощность"

msgid "  {index}: y {y0} … {y1} mm, power {power}, S {s}"
msgstr "  {index}: y {y0} … {y1} мм, мощность {power}, S {s}"

msgid "Square {side} mm, line {width} mm, calibration {state}"
msgstr "Квадрат {side} мм, линия {width} мм, калибровка: {state}"

msgid "applied"
msgstr "применена"

msgid "not applied"
msgstr "не применена"

msgid "Diagonals: d1 front-left to back-right, d2 front-right to back-left; theta = (d1 - d2) / (sqrt(2) * side)"
msgstr "Диагонали: d1 — от переднего левого к заднему правому, d2 — от переднего правого к заднему левому; theta = (d1 - d2) / (sqrt(2) * сторона)"

msgid "How the measurement becomes new calibration values (the scales multiply, the angle adds):"
msgstr "Как замер превращается в новые значения калибровки (масштабы умножаются, угол складывается):"

msgid "Write these numbers into the calibration file"
msgstr "Запишите эти числа в файл калибровки"

msgid "Choose a pattern: bars, dose or square"
msgstr "Выберите шаблон: bars, dose или square"

msgid "Cannot build the pattern: {error}"
msgstr "Не удалось собрать шаблон: {error}"

msgid "write a calibration program"
msgstr "записать калибровочную программу"

msgid "write a calibration program: test bars, dose strip, skew square"
msgstr "записать калибровочную программу: тестовые штрихи, полоска дозы, квадрат для перекоса"

msgid "test bars: lines and gaps of known widths"
msgstr "тестовые штрихи: линии и промежутки известных ширин"

msgid "test bars: lines and gaps of known widths, horizontal then vertical"
msgstr "тестовые штрихи: линии и промежутки известных ширин, сначала горизонтальные, затем вертикальные"

msgid "bar widths, mm, in the order to draw them"
msgstr "ширины штрихов, мм, в порядке рисования"

msgid "bar length, mm"
msgstr "длина штриха, мм"

msgid "apply spot compensation (off by default: the bars measure the spot)"
msgstr "применить компенсацию пятна (по умолчанию выключена: штрихи и меряют пятно)"

msgid "apply spot compensation (off by default)"
msgstr "применить компенсацию пятна (по умолчанию выключена)"

msgid "apply spot compensation (refused with per-row power)"
msgstr "применить компенсацию пятна (с мощностью по строкам — отказ)"

msgid "dose strip: tiles stacked in Y, one power each"
msgstr "полоска дозы: прямоугольники друг над другом по Y, у каждого своя мощность"

msgid "dose strip: tiles stacked in Y, bottom to top with rising power"
msgstr "полоска дозы: прямоугольники друг над другом по Y, снизу вверх мощность растёт"

msgid "power fractions, comma separated, bottom to top"
msgstr "доли мощности через запятую, снизу вверх"

msgid "lowest power fraction of a geometric series"
msgstr "нижняя доля мощности геометрического ряда"

msgid "highest power fraction of the series"
msgstr "верхняя доля мощности ряда"

msgid "how many levels the series has"
msgstr "сколько уровней в ряду"

msgid "tile width, mm"
msgstr "ширина прямоугольника, мм"

msgid "tile height, mm"
msgstr "высота прямоугольника, мм"

msgid "skew square: a contour L×L to measure the diagonals"
msgstr "квадрат для перекоса: контур L×L для замера диагоналей"

msgid "square side, mm"
msgstr "сторона квадрата, мм"

msgid "contour line width, mm"
msgstr "ширина линии контура, мм"

msgid "draw it through the profile's calibration: the result is a residual"
msgstr "нарисовать через калибровку профиля: результат будет остатком"

msgid "Wrote {path}: {rows} rows, {segments} segments"
msgstr "Записано {path}: строк {rows}, отрезков {segments}"

msgid "Bar width {width} mm is below the row step {step} mm: it may print as one row or vanish"
msgstr "Ширина штриха {width} мм меньше шага строк {step} мм: он может напечататься одной строкой или пропасть"

msgid "No common frame: the mirror and the placement use this layer's own copper; a second side of the same board needs --frame"
msgstr "Общей рамки нет: зеркало и постановка идут по своей меди этого слоя; для второй стороны той же платы нужен --frame"

msgid "Copper sticks out of the board frame: x {x0} … {x1} against {f0} … {f1}, y {y0} … {y1} against {f2} … {f3} mm"
msgstr "Медь выходит за рамку платы: x {x0} … {x1} против {f0} … {f1}, y {y0} … {y1} против {f2} … {f3} мм"

msgid "board outline (Edge_Cuts) shared by both sides"
msgstr "контур платы (Edge_Cuts), общий для обеих сторон"

msgid "Profile {path}: scan.row_step_um = {row:g} um is not a whole number of motor steps along Y: machine.steps_per_mm_y = {per:g} step/mm gives a {step:g} um step, and {row:g} um is {count:g} of them — rows would land {low:g} and {high:g} um apart in turn"
msgstr "Профиль {path}: scan.row_step_um = {row:g} мкм — не целое число шагов мотора по Y: machine.steps_per_mm_y = {per:g} шаг/мм даёт шаг {step:g} мкм, а {row:g} мкм — это {count:g} шага; строки легли бы через {low:g} и {high:g} мкм попеременно"

msgid "{count} segments are shorter than the X motor step {step} mm: their edges snap to it, so the exposed ends move by up to half a step"
msgstr "Отрезков короче шага мотора по X ({step} мм): {count}; их края прилипают к шагу, и концы засветки уезжают до половины шага"
